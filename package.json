{
  "name": "typora-mcp-server",
  "version": "0.1.0",
  "description": "A local STDIO MCP server for inspecting, debugging, and safely automating running Typora instances.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DoubleW2w/typora-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/DoubleW2w/typora-mcp/issues"
  },
  "homepage": "https://github.com/DoubleW2w/typora-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "typora",
    "debugging",
    "claude-code",
    "codex"
  ],
  "type": "module",
  "bin": {
    "typora-mcp": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:live": "npm run build && node dist/test/live-fixture.js",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "playwright-core": "^1.63.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
